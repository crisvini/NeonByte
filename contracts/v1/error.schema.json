{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neonbyte:contracts:v1:error",
  "title": "Local API error response",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "invalid_request",
        "unauthorized",
        "not_found",
        "conflict",
        "payload_too_large",
        "unsupported_media_type",
        "invalid_content",
        "internal_error"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": ["code", "message"],
  "additionalProperties": false
}

