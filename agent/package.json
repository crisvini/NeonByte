{
  "name": "@neonbyte/spotify-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-web-assets.mjs",
    "typecheck": "tsc -p tsconfig.tests.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:offline": "node --import tsx --test tests/offline/*.test.ts",
    "check": "npm run build && npm run typecheck && npm test",
    "dev": "node --env-file=../.env --import tsx src/main.ts",
    "start": "node --env-file=../.env dist/main.js",
    "auth": "node --env-file=../.env dist/main.js auth"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "gifuct-js": "2.1.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
