# Local Spotify agent configuration. This file contains placeholders only.
# Copy it to .env and set the public Client ID created in the Spotify Developer Dashboard.
SPOTIFY_CLIENT_ID=replace-with-your-spotify-app-client-id
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/callback

# Agent polling and reconnect settings.
SPOTIFY_POLL_INTERVAL_MS=15000
SPOTIFY_REQUEST_TIMEOUT_MS=10000
SPOTIFY_RECONNECT_MAX_INTERVAL_MS=60000

# The interface always binds to loopback; change the port together with the redirect URI.
NEONBYTE_PORT=8787
NEONBYTE_MODE=auto
NEONBYTE_AGENT_TIMEOUT_MS=45000
# Enable mock controls for testing without a Spotify account or clock.
NEONBYTE_MOCK=true

# Reserved documentation address; replace it with the actual local address.
NEONBYTE_DEVICE_URL=http://192.0.2.1
# Create a local token after the pairing flow is defined.
NEONBYTE_PAIRING_TOKEN=replace-with-a-local-token
