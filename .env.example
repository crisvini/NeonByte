# Configuração local do agente Spotify. Este arquivo contém apenas placeholders.
# Copie para .env e informe o Client ID público criado no Spotify Developer Dashboard.
SPOTIFY_CLIENT_ID=replace-with-your-spotify-app-client-id
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/callback

# Polling e reconexão do agente.
SPOTIFY_POLL_INTERVAL_MS=15000
SPOTIFY_REQUEST_TIMEOUT_MS=10000
SPOTIFY_RECONNECT_MAX_INTERVAL_MS=60000

# A interface sempre se vincula ao loopback; ajuste a porta junto com o redirect URI.
NEONBYTE_PORT=8787
NEONBYTE_MODE=auto
NEONBYTE_AGENT_TIMEOUT_MS=45000
# Ativa os controles mock para testar sem conta Spotify ou relógio.
NEONBYTE_MOCK=true

# Endereço reservado para documentação; substitua pelo endereço real local.
NEONBYTE_DEVICE_URL=http://192.0.2.1
# Crie um token local quando o fluxo de pareamento for definido.
NEONBYTE_PAIRING_TOKEN=replace-with-a-local-token

