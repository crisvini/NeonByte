# Local agent configuration with a placeholder Client ID and non-secret defaults.
# Copy it to .env and set the public Client ID created in the Spotify Developer Dashboard.
SPOTIFY_CLIENT_ID=replace-with-your-spotify-app-client-id
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/callback

# Agent polling and reconnect settings.
SPOTIFY_POLL_INTERVAL_MS=15000
SPOTIFY_REQUEST_TIMEOUT_MS=10000
SPOTIFY_RECONNECT_MAX_INTERVAL_MS=60000

# The interface binds to loopback. Change the port together with the redirect URI.
NEONBYTE_PORT=8787
# Local playback-preview freshness timeout; the firmware has its own timeout.
NEONBYTE_AGENT_TIMEOUT_MS=45000
